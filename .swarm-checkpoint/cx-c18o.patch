+            QVERIFY(failed.isEmpty());
+            const QList<int> peaks = ready.front().at(3).value<QList<int>>();
+            QVERIFY(peaks.size() >= 28);
+            QVERIFY(peaks.at(5) > 50);
+            QVERIFY(peaks.at(15) < 10);
+            QVERIFY(peaks.at(25) > 50);
+        }
